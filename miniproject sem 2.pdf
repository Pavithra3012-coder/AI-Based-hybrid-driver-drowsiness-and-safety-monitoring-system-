    border: 1px solid canvasText;
    forced-color-adjust: none;
    border-radius: 5px;
  }

  .bolt-tooltip-fade-out.bolt-callout {
    background-color: canvas;
    color: canvasText;
  }
}

@keyframes tooltip-fade-in {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes tooltip-fade-out {
  from {
    opacity: 1;
  }

  to {
    opacity: 0;
  }
}</style><style>@font-face {
