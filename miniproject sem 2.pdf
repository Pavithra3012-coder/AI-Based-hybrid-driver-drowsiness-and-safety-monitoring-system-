}

.header-avatar {
  forced-color-adjust: none;
}

.header .header-avatar button:hover {
  outline: 4px solid var(--hover-background-color);
}

.header .header-avatar button:active {
  outline: 4px solid var(--active-background-color);
}

.header .header-avatar button:focus {
  outline: 4px solid var(--palette-black-alpha-30);
}

.header-avatar {
  display: flex !important;
  align-items: center;
  justify-content: center;
}

